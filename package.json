{
  "name": "support_copilot_frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,json,css}\" \"components/**/*.{ts,tsx,js,jsx,json,css}\" \"hooks/**/*.{ts,tsx,js,jsx,json}\" \"services/**/*.{ts,tsx,js,jsx,json}\" \"store/**/*.{ts,tsx,js,jsx,json}\" \"types/**/*.{ts,tsx,js,jsx,json}\" \"utils/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,tsx,js,jsx,json,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx,json,css}\" \"components/**/*.{ts,tsx,js,jsx,json,css}\" \"hooks/**/*.{ts,tsx,js,jsx,json}\" \"services/**/*.{ts,tsx,js,jsx,json}\" \"store/**/*.{ts,tsx,js,jsx,json}\" \"types/**/*.{ts,tsx,js,jsx,json}\" \"utils/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,tsx,js,jsx,json,mjs}\"",
    "check:commit": "npm run typecheck && npm run lint && npm run build",
    "check:push": "npm run check:commit && npm test",
    "prepare": "husky",
    "test": "echo \"No tests specified yet\" && exit 0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-query-devtools": "^5.59.16",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "joi": "^17.13.3",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
